# PostgreSQL connection (used by API, cmd/migrate, sqlc)
DATABASE_URL=postgres://openrouting:openrouting@localhost:5432/openrouting?sslmode=disable
# Redis connection (used by /readyz)
REDIS_URL=redis://localhost:6379/0
# OTel exporter target — D-14
OTEL_EXPORTER=stdout
# OTel OTLP endpoint (required when OTEL_EXPORTER=otlp) — D-14
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTel OTLP protocol — D-14
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# HTTP listen address
LISTEN_ADDR=:8080
# orgDB validation mode: panic (dev/test) or error (prod) — per D-02
ORGDB_VALIDATION_MODE=panic
