# Build context = repo root (needs web/ + deploy/nginx.conf).
# syntax=docker/dockerfile:1
FROM node:22-slim AS build
RUN corepack enable
WORKDIR /app
COPY web/ ./
# public/shoelace/assets/icons is a symlink into node_modules (setup:icons);
# dereference the real icons into the build context so vite copies them into
# dist (the symlink is broken here — node_modules is .dockerignore'd).
RUN pnpm install --frozen-lockfile \
 && rm -rf apps/admin/public/shoelace/assets/icons \
 && mkdir -p apps/admin/public/shoelace/assets \
 && cp -rL apps/admin/node_modules/@shoelace-style/shoelace/dist/assets/icons apps/admin/public/shoelace/assets/icons \
 && pnpm --filter @open-routing/admin build

FROM nginx:alpine
COPY --from=build /app/apps/admin/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
