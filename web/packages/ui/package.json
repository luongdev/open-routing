  "dependencies": {
    "@lit/reactive-element": "^2.1.2",
    "@lit/task": "^1.0.0",
    "lit": "^3.0.0",
    "openapi-fetch": "^0.13.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.0",
    "js-yaml": "^4.1.0",
    "openapi-typescript": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
