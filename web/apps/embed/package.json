{
  "name": "@open-routing/catalog-embed",
  "version": "0.1.0-pre.1",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./dist/embed.js"
  ],
  "main": "./dist/embed.js",
  "module": "./dist/embed.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/embed.js",
      "types": "./dist/index.d.ts"
    },
    "./hash-router-adapter": {
      "import": "./dist/hash-router-adapter.js",
      "types": "./dist/hash-router-adapter.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.types.json && node scripts/write-public-types.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "size": "node scripts/check-gzip-size.mjs",
    "pack:dry": "pnpm pack --dry-run",
    "pack:smoke": "node scripts/pack-smoke.mjs"
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@lit-labs/router": "^0.1.4",
    "@open-routing/ui": "workspace:*",
    "@playwright/test": "^1.60.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "happy-dom": "^20.9.0",
    "lit": "^3.3.3",
    "openapi-fetch": "^0.13.8",
    "urlpattern-polyfill": "^10.1.0",
    "vite": "^8.0.13",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@lit/localize": "^0.12.2"
  }
}
